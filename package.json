{
  "name": "cncstream",
  "version": "1.1.1",
  "description": "CNC controller for GRBL and grblHAL machines",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "node scripts/preview.js",
    "package": "electron-vite build && node scripts/package.js",
    "package:win": "electron-vite build && node scripts/package.js --win",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "i18next": "^25.8.11",
    "react-i18next": "^16.5.4",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@types/cacheable-request": "^6.0.3",
    "@types/http-cache-semantics": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/responselike": "^1.0.3",
    "@types/three": "^0.171.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^41.7.1",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "zustand": "^5.0.0"
  },
